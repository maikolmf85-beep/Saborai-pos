# Clave de API de Google Gemini para Nysa AI y Carga Inteligente de Menú (/api/parse-menu)
# Obtén tu clave gratis en: https://aistudio.google.com/app/apikey
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza el valor con tu API key real
GEMINI_API_KEY=tu_clave_aqui
VITE_GEMINI_API_KEY=tu_clave_aqui

# Integración TiloPay (Pagos seguros vía Vercel Serverless Functions)
TILOPAY_API_KEY=tu_tilopay_api_key
TILOPAY_API_USER=tu_usuario_api
TILOPAY_API_PASSWORD=tu_contraseña_api
TILOPAY_ENVIRONMENT=sandbox
