# Motor de Inteligencia Artificial de Saborai (Gemini gratuito)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key
VITE_GEMINI_API_KEY=tu_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# WhatsApp Cloud API / soporte inteligente de Nyza
# El número debe ir con código de país, sin espacios ni signos en VITE_WHATSAPP_SUPPORT_NUMBER.
VITE_WHATSAPP_SUPPORT_NUMBER=506XXXXXXXX
WHATSAPP_ACCESS_TOKEN=token_permanente_de_meta
WHATSAPP_PHONE_NUMBER_ID=id_del_numero_de_whatsapp
WHATSAPP_BUSINESS_ACCOUNT_ID=id_de_la_cuenta_de_whatsapp
WHATSAPP_VERIFY_TOKEN=crea_un_token_largo_y_aleatorio
WHATSAPP_GRAPH_API_VERSION=v26.0
META_APP_SECRET=secreto_de_la_app_de_meta_para_validar_firmas

# Backend y seguridad (obligatorio en producción)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_solo_backend
SUPABASE_ANON_KEY=tu_clave_anon_publica
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica
JWT_SECRET=usa_un_secreto_aleatorio_de_al_menos_32_caracteres
ALLOWED_ORIGINS=https://saborai.site,https://www.saborai.site,https://pos.saborai.site,https://admin.saborai.site

# Integración TiloPay (Pagos seguros vía Vercel Serverless Functions)
TILOPAY_API_KEY=tu_tilopay_api_key
TILOPAY_API_USER=tu_usuario_api
TILOPAY_API_PASSWORD=tu_contraseña_api
TILOPAY_ENVIRONMENT=sandbox
TILOPAY_SECRET_KEY=tu_secreto_de_firma_de_webhooks

# Recuperación de contraseña y correos transaccionales (Resend)
# El dominio remitente debe estar verificado en Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=soporte@saborai.site
