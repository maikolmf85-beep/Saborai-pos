---
import BaseLayout from '../layouts/BaseLayout.astro';

const supportEmail = 'maikolr85@outlook.es';
const provinces = [
  'San José',
  'Alajuela',
  'Cartago',
  'Heredia',
  'Guanacaste',
  'Puntarenas',
  'Limón',
];
---

<BaseLayout
  title="Beta gratis para restaurantes en Costa Rica"
  description="Buscamos de 3 a 5 restaurantes en Costa Rica para probar SaborAI POS sin costo durante la beta. Conoce sus funciones y postúlate."
  canonicalUrl="https://blog.saborai.site/beta"
  keywords={['beta POS restaurantes', 'POS para restaurantes Costa Rica', 'SaborAI beta', 'software gastronómico']}
>
  <section class="beta-hero relative isolate overflow-hidden">
    <div class="beta-glow beta-glow-one" aria-hidden="true"></div>
    <div class="beta-glow beta-glow-two" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-14 sm:px-6 md:py-20 lg:grid-cols-[1.05fr_.95fr] lg:px-8 lg:py-24">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.15em] text-white/90">
          <span class="h-2 w-2 rounded-full bg-[#b9d7a7]" aria-hidden="true"></span>
          Beta gratuita · Costa Rica
        </span>
        <h1 class="mt-6 font-heading text-4xl font-black leading-[1.06] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Buscamos de 3 a 5 restaurantes para probar <span class="text-[#c9dfa9]">SaborAI POS.</span>
        </h1>
        <p class="mt-5 max-w-xl text-base leading-7 text-white/75 sm:text-lg">
          Si sos dueño o encargada de un restaurante, ayudanos a poner a prueba una forma más simple de llevar el servicio, el menú y la facturación. Participar en esta beta no tiene costo.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#beta-form" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#c9dfa9] px-5 py-3 font-bold text-[#22342b] shadow-lg shadow-black/10 transition hover:-translate-y-0.5 hover:bg-[#d8e9c3] focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#203a31]">
            Postular mi restaurante <span aria-hidden="true">↓</span>
          </a>
          <a href="#funciones" class="inline-flex items-center justify-center rounded-xl border border-white/25 bg-white/5 px-5 py-3 font-bold text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#203a31]">
            Ver qué incluye
          </a>
        </div>
        <p class="mt-5 text-sm font-medium text-white/60">Cupos limitados · La participación durante la beta es sin costo</p>
      </div>

      <div class="beta-visual-wrap mx-auto w-full max-w-xl" role="img" aria-label="Ilustración conceptual de las herramientas de SaborAI POS">
        <div class="beta-visual-card">
          <div class="flex items-center justify-between gap-3 border-b border-stone-100 px-5 py-4">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#718174]">SaborAI POS</p>
              <p class="mt-1 text-sm font-bold text-[#26372d]">Herramientas para el servicio</p>
            </div>
            <span class="rounded-full bg-[#edf3e6] px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-[#456047]">Vista ilustrativa</span>
          </div>
          <div class="grid gap-3 p-4 sm:grid-cols-[1.05fr_.95fr] sm:p-5">
            <div class="rounded-2xl bg-[#f4f6f1] p-4">
              <div class="flex items-center justify-between">
                <p class="text-xs font-bold uppercase tracking-wider text-[#59695a]">Salón principal</p>
                <span class="text-[10px] font-semibold text-[#829081]">Mesas</span>
              </div>
              <div class="mt-4 grid grid-cols-3 gap-2" aria-hidden="true">
                <span class="beta-table beta-table-active">01</span>
                <span class="beta-table">02</span>
                <span class="beta-table">03</span>
                <span class="beta-table">04</span>
                <span class="beta-table beta-table-active">05</span>
                <span class="beta-table">06</span>
              </div>
              <p class="mt-4 text-[11px] text-[#718174]">Organiza tu espacio a tu manera</p>
            </div>
            <div class="flex flex-col gap-3">
              <div class="rounded-2xl border border-[#e7ebe2] bg-white p-4 shadow-sm">
                <div class="flex items-center gap-2">
                  <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#eaf1e2] text-sm font-black text-[#4b704f]" aria-hidden="true">✦</span>
                  <div>
                    <p class="text-xs font-bold text-[#26372d]">Nyza IA</p>
                    <p class="text-[10px] text-[#829081]">Ayuda dentro del POS</p>
                  </div>
                </div>
              </div>
              <div class="rounded-2xl border border-[#e7ebe2] bg-white p-4 shadow-sm">
                <div class="flex items-center gap-2">
                  <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#f2eee5] text-sm font-bold text-[#6c604b]" aria-hidden="true">PDF</span>
                  <div>
                    <p class="text-xs font-bold text-[#26372d]">Tu menú, listo para revisar</p>
                    <p class="text-[10px] text-[#829081]">Imagen o documento PDF</p>
                  </div>
                </div>
              </div>
              <div class="rounded-2xl bg-[#263f34] p-4 text-white">
                <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#c9dfa9]">Diseñado para la operación</p>
                <p class="mt-2 text-sm font-semibold leading-5">Salones, mesas, menú y caja en un solo POS.</p>
              </div>
            </div>
          </div>
        </div>
        <p class="mt-3 text-center text-xs text-white/50">Ilustración conceptual; no es una captura de pantalla del producto.</p>
      </div>
    </div>
  </section>

  <section id="funciones" class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-18 lg:px-8 lg:py-20">
      <div class="mx-auto mb-9 max-w-2xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#5b795b]">Funciones disponibles en el POS</p>
        <h2 class="mt-3 font-heading text-3xl font-black tracking-tight text-[#26372d] sm:text-4xl">Hecho pensando en el ritmo real de un restaurante.</h2>
        <p class="mt-4 text-sm leading-6 text-[#667168] sm:text-base">Estas capacidades están en la versión de producción que revisamos. En la beta podrás probarlas con la configuración de tu negocio.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <article class="beta-feature-card">
          <span class="beta-feature-icon" aria-hidden="true">✦</span>
          <h3>Asistente con IA</h3>
          <p>Nyza puede apoyar tareas dentro del POS, como organizar salones y crear mesas, y ayudar a preparar tu menú.</p>
        </article>
        <article class="beta-feature-card">
          <span class="beta-feature-icon beta-feature-icon-sand" aria-hidden="true">PDF</span>
          <h3>Importa tu menú</h3>
          <p>Sube una imagen o un PDF para extraer categorías y productos con IA; revisa el resultado antes de incorporarlo.</p>
        </article>
        <article class="beta-feature-card">
          <span class="beta-feature-icon beta-feature-icon-sage" aria-hidden="true">↻</span>
          <h3>Modo offline</h3>
          <p>El POS conserva datos de trabajo localmente y sincroniza las operaciones pendientes cuando vuelve la conexión.</p>
          <p class="beta-feature-note">Algunas acciones pueden necesitar internet para completarse.</p>
        </article>
        <article class="beta-feature-card">
          <span class="beta-feature-icon beta-feature-icon-dark" aria-hidden="true">▦</span>
          <h3>Salones y mesas</h3>
          <p>Crea salones y acomoda las mesas para que el plano refleje la distribución de tu restaurante.</p>
        </article>
        <article class="beta-feature-card sm:col-span-2 lg:col-span-4 lg:flex lg:items-center lg:gap-5">
          <span class="beta-feature-icon beta-feature-icon-sage shrink-0" aria-hidden="true">₡</span>
          <div>
            <h3>Facturación electrónica · Hacienda v4.4</h3>
            <p>El POS incluye flujos para emitir comprobantes electrónicos con el formato v4.4. La configuración tributaria y los comprobantes de cada negocio deben revisarse antes de operar.</p>
          </div>
        </article>
      </div>
      <p class="mt-5 text-center text-xs leading-5 text-[#758076]">La configuración, conexión y comportamiento de las funciones se validan con cada restaurante participante; no se promete compatibilidad universal con todos los procesos fiscales o de internet.</p>
    </div>
  </section>

  <section class="bg-[#f3f5f0]">
    <div class="mx-auto grid max-w-7xl gap-9 px-4 py-14 sm:px-6 md:grid-cols-[.85fr_1.15fr] md:items-start md:py-18 lg:px-8 lg:py-20">
      <div class="md:sticky md:top-24">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#5b795b]">Cohorte pequeña, feedback cercano</p>
        <h2 class="mt-3 font-heading text-3xl font-black tracking-tight text-[#26372d] sm:text-4xl">¿Te gustaría probarlo en tu restaurante?</h2>
        <p class="mt-4 text-sm leading-6 text-[#667168] sm:text-base">Buscamos dueños o encargados de restaurantes en Costa Rica que quieran probar el POS y compartir qué les funciona y qué deberíamos mejorar.</p>
        <ul class="mt-6 space-y-3 text-sm text-[#435148]">
          <li class="flex gap-3"><span class="font-bold text-[#587757]" aria-hidden="true">✓</span><span>Entre 3 y 5 restaurantes serán seleccionados.</span></li>
          <li class="flex gap-3"><span class="font-bold text-[#587757]" aria-hidden="true">✓</span><span>La participación durante la beta es sin costo.</span></li>
          <li class="flex gap-3"><span class="font-bold text-[#587757]" aria-hidden="true">✓</span><span>Enviar el correo no confirma automáticamente un cupo.</span></li>
        </ul>
        <div class="mt-7 rounded-2xl border border-[#dfe5d9] bg-white p-4 text-sm leading-6 text-[#667168]">
          <strong class="text-[#334438]">¿Preferís escribir directamente?</strong><br />
          <a class="font-bold text-[#4c704d] underline decoration-[#b7c9ab] underline-offset-4 hover:text-[#2b4a36]" href={`mailto:${supportEmail}?subject=${encodeURIComponent('Beta SaborAI POS')}`}>{supportEmail}</a>
        </div>
      </div>

      <div id="beta-form" class="scroll-mt-24 rounded-[1.75rem] border border-[#e1e6dd] bg-white p-5 shadow-xl shadow-[#26372d]/5 sm:p-8">
        <div class="mb-6">
          <span class="inline-flex rounded-full bg-[#edf3e6] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[#4e6d4f]">Postulación a la beta</span>
          <h2 class="mt-3 font-heading text-2xl font-black text-[#26372d] sm:text-3xl">Cuéntanos sobre tu restaurante</h2>
          <p class="mt-2 text-sm leading-6 text-[#667168]">Completa lo básico y prepara un correo para que puedas revisarlo y enviarlo.</p>
        </div>

        <form id="beta-signup-form" action={`mailto:${supportEmail}`} method="post" enctype="text/plain" class="space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="beta-name" class="beta-label">Tu nombre <span aria-hidden="true">*</span></label>
              <input id="beta-name" name="name" type="text" autocomplete="name" maxlength="100" required class="beta-input" placeholder="Nombre y apellido" />
            </div>
            <div>
              <label for="beta-restaurant" class="beta-label">Nombre del restaurante <span aria-hidden="true">*</span></label>
              <input id="beta-restaurant" name="restaurant" type="text" autocomplete="organization" maxlength="120" required class="beta-input" placeholder="¿Cómo se llama tu negocio?" />
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="beta-email" class="beta-label">Correo electrónico <span aria-hidden="true">*</span></label>
              <input id="beta-email" name="email" type="email" autocomplete="email" maxlength="160" required class="beta-input" placeholder="tu@restaurante.com" />
            </div>
            <div>
              <label for="beta-phone" class="beta-label">Teléfono <span class="font-normal text-[#8a938a]">(opcional)</span></label>
              <input id="beta-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" class="beta-input" placeholder="Para coordinar con más facilidad" />
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="beta-province" class="beta-label">Provincia <span aria-hidden="true">*</span></label>
              <select id="beta-province" name="province" required class="beta-input beta-select">
                <option value="" selected disabled>Selecciona una provincia</option>
                {provinces.map((province) => <option value={province}>{province}</option>)}
              </select>
            </div>
            <div>
              <label for="beta-current-pos" class="beta-label">¿Qué usas hoy para gestionar el restaurante? <span class="font-normal text-[#8a938a]">(opcional)</span></label>
              <select id="beta-current-pos" name="current-pos" class="beta-input beta-select">
                <option value="">Selecciona una opción</option>
                <option value="Papel o Excel">Papel o Excel</option>
                <option value="Otro POS">Otro POS</option>
                <option value="Otro sistema">Otro sistema</option>
                <option value="No tengo un sistema">No tengo un sistema</option>
              </select>
            </div>
          </div>
          <label class="flex items-start gap-3 rounded-xl bg-[#f6f7f4] p-4 text-sm leading-5 text-[#59665c]">
            <input type="checkbox" name="role-confirmation" value="Confirmo que soy dueño/a o encargado/a del restaurante" required class="mt-0.5 h-4 w-4 shrink-0 accent-[#527451]" />
            <span>Confirmo que soy dueño/a o encargado/a del restaurante y acepto que me contacten para coordinar la beta.</span>
          </label>
          <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#263f34] px-5 py-3.5 font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-[#345543] focus:outline-none focus:ring-2 focus:ring-[#698a67] focus:ring-offset-2 sm:w-auto">
            Preparar correo para postularme <span aria-hidden="true">→</span>
          </button>
          <p id="email-draft-status" class="rounded-xl border border-[#d8e6d0] bg-[#f2f7ee] p-4 text-sm leading-6 text-[#3f5a3f]" role="status" aria-live="polite" hidden></p>
          <p class="text-xs leading-5 text-[#7a847b]">Importante: este sitio no recibe ni guarda los datos. Al continuar, se abrirá tu aplicación de correo con un borrador dirigido a {supportEmail}. Revisa el mensaje y pulsa Enviar; la postulación solo llega si tú la envías. La selección de cupos se confirma por separado.</p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const betaForm = document.getElementById('beta-signup-form');
    const emailDraftStatus = document.getElementById('email-draft-status');

    if (betaForm instanceof HTMLFormElement && emailDraftStatus instanceof HTMLElement) {
      betaForm.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!betaForm.reportValidity()) return;

        const formData = new FormData(betaForm);
        const value = (key) => String(formData.get(key) || 'No especificado').trim();
        const subject = 'Postulación a la beta gratuita de SaborAI POS';
        const body = [
          'Hola, quiero postular mi restaurante a la beta gratuita de SaborAI POS.',
          '',
          `Nombre: ${value('name')}`,
          `Restaurante: ${value('restaurant')}`,
          `Correo: ${value('email')}`,
          `Teléfono: ${value('phone')}`,
          `Provincia: ${value('province')}`,
          `Sistema actual: ${value('current-pos')}`,
          `Confirmación: ${value('role-confirmation')}`,
          '',
          'Enviado desde el formulario informativo de beta en blog.saborai.site.',
        ].join('\n');

        emailDraftStatus.textContent = 'Se abrió tu aplicación de correo con un borrador. La solicitud todavía no se ha enviado: revísala y pulsa Enviar. Esta página no guarda tus datos.';
        emailDraftStatus.removeAttribute('hidden');
        const mailtoUrl = `mailto:${supportEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        window.location.href = mailtoUrl;
      });
    }
  </script>

  <style>
    .beta-hero {
      background: linear-gradient(124deg, #203a31 0%, #29473a 52%, #334d3c 100%);
    }

    .beta-glow {
      position: absolute;
      width: 26rem;
      height: 26rem;
      border-radius: 9999px;
      pointer-events: none;
      filter: blur(1px);
    }

    .beta-glow-one {
      top: -15rem;
      right: 7%;
      background: radial-gradient(circle, rgb(194 218 164 / 16%), transparent 68%);
    }

    .beta-glow-two {
      bottom: -19rem;
      left: -10rem;
      background: radial-gradient(circle, rgb(255 255 255 / 7%), transparent 69%);
    }

    .beta-visual-wrap {
      transform: rotate(0.6deg);
    }

    .beta-visual-card {
      overflow: hidden;
      border: 1px solid rgb(255 255 255 / 65%);
      border-radius: 1.6rem;
      background: #fff;
      box-shadow: 0 28px 80px rgb(10 27 19 / 25%);
    }

    .beta-table {
      display: flex;
      aspect-ratio: 1.25;
      align-items: center;
      justify-content: center;
      border: 1px solid #dce4d7;
      border-radius: 0.8rem;
      background: #fff;
      color: #647365;
      font-size: 0.7rem;
      font-weight: 700;
    }

    .beta-table-active {
      border-color: #9fb995;
      background: #eaf1e2;
      color: #405b43;
    }

    .beta-feature-card {
      border: 1px solid #e4e9e1;
      border-radius: 1.15rem;
      background: #fff;
      padding: 1.25rem;
      box-shadow: 0 5px 18px rgb(38 55 45 / 3%);
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    .beta-feature-card:hover {
      transform: translateY(-2px);
      border-color: #cbd9c3;
      box-shadow: 0 12px 28px rgb(38 55 45 / 8%);
    }

    .beta-feature-icon {
      display: inline-flex;
      width: 2.7rem;
      height: 2.7rem;
      align-items: center;
      justify-content: center;
      border-radius: 0.85rem;
      background: #e9f0e1;
      color: #48664a;
      font-size: 0.9rem;
      font-weight: 800;
    }

    .beta-feature-icon-sand {
      background: #f3eee4;
      color: #6b5d42;
      font-size: 0.67rem;
    }

    .beta-feature-icon-sage {
      background: #edf2e8;
      color: #4f6b4f;
      font-size: 1.35rem;
    }

    .beta-feature-icon-dark {
      background: #e8eeea;
      color: #334d3c;
      font-size: 1.3rem;
    }

    .beta-feature-card h3 {
      margin-top: 1rem;
      color: #26372d;
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: -0.015em;
    }

    .beta-feature-card p {
      margin-top: 0.5rem;
      color: #667168;
      font-size: 0.875rem;
      line-height: 1.6;
    }

    .beta-feature-card .beta-feature-note {
      margin-top: 0.65rem;
      color: #788278;
      font-size: 0.75rem;
      line-height: 1.5;
    }

    .beta-label {
      display: block;
      margin-bottom: 0.45rem;
      color: #38483c;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .beta-input {
      display: block;
      width: 100%;
      min-height: 2.9rem;
      border: 1px solid #dfe5dc;
      border-radius: 0.75rem;
      background: #fff;
      padding: 0.7rem 0.8rem;
      color: #27392e;
      font: inherit;
      font-size: 0.875rem;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    .beta-input::placeholder {
      color: #a0a89f;
    }

    .beta-input:focus {
      border-color: #78936f;
      outline: none;
      box-shadow: 0 0 0 3px rgb(120 147 111 / 18%);
    }

    .beta-select {
      appearance: auto;
      color: #3c4a3f;
    }

    @media (prefers-reduced-motion: reduce) {
      .beta-feature-card,
      .beta-input {
        transition: none;
      }

      .beta-feature-card:hover {
        transform: none;
      }
    }
  </style>
</BaseLayout>
