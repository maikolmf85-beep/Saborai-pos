---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guias = (await getCollection('guias')).sort((a, b) => a.data.order - b.data.order);

const categoryLabels: Record<string, string> = {
  'primeros-pasos': 'Primeros Pasos',
  'facturacion': 'Facturación',
  'inventario': 'Inventario',
  'mesas': 'Mesas y Órdenes',
  'caja': 'Caja y Cobros',
  'cocina': 'Módulo Cocina',
  'ia': 'Inteligencia Artificial',
  'configuracion': 'Configuración',
};

const categoryIcons: Record<string, string> = {
  'primeros-pasos': '🚀',
  'facturacion': '🧾',
  'inventario': '📦',
  'mesas': '🪑',
  'caja': '💰',
  'cocina': '👨‍🍳',
  'ia': '🤖',
  'configuracion': '⚙️',
};

const grouped = guias.reduce((acc, guia) => {
  const cat = guia.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(guia);
  return acc;
}, {} as Record<string, typeof guias>);
---

<BaseLayout
  title="Guías de Uso — SaborAI POS"
  description="Aprende a usar SaborAI POS con nuestras guías paso a paso. Desde los primeros pasos hasta configuraciones avanzadas."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary via-stone-800 to-primary py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-accent/20 text-accent rounded-full text-sm font-bold mb-5 border border-accent/30">
        📖 Guías de Uso
      </span>
      <h1 class="text-4xl md:text-5xl font-black font-heading text-white mb-4">
        Aprende a usar <span class="text-accent">SaborAI POS</span>
      </h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">
        Tutoriales paso a paso para sacar el máximo provecho de cada funcionalidad.
      </p>
    </div>
  </section>

  <!-- Quick Nav -->
  <section class="border-b border-stone-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap gap-2">
      {Object.entries(categoryLabels).filter(([key]) => grouped[key]).map(([key, label]) => (
        <a
          href={`#${key}`}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-neutral bg-stone-100 hover:bg-sage-100 hover:text-sage-700 rounded-full transition-colors"
        >
          {categoryIcons[key]} {label}
        </a>
      ))}
    </div>
  </section>

  <!-- Guides by Category -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
    {Object.entries(grouped).map(([cat, items]) => (
      <div id={cat}>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-3xl">{categoryIcons[cat] || '📖'}</span>
          <div>
            <h2 class="text-2xl font-black font-heading text-primary">{categoryLabels[cat] || cat}</h2>
            <p class="text-sm text-neutral">{items.length} {items.length === 1 ? 'guía' : 'guías'}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {items.map((guia) => (
            <a
              href={`/guias/${guia.slug}`}
              class="group bg-white rounded-2xl border border-stone-200/80 p-5 card-hover shadow-sm"
            >
              <div class="text-3xl mb-3">{guia.data.icon}</div>
              <h3 class="font-bold font-heading text-primary group-hover:text-sage-700 transition-colors mb-2 leading-snug">
                {guia.data.title}
              </h3>
              <p class="text-sm text-neutral line-clamp-2 mb-4">{guia.data.description}</p>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="badge-sage text-[9px]">{guia.data.difficulty}</span>
                <span class="ml-auto text-xs font-bold text-sage-600 group-hover:text-sage-800 transition-colors">
                  Ver guía →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    {guias.length === 0 && (
      <div class="text-center py-20 bg-stone-50 rounded-2xl border border-stone-200">
        <span class="text-5xl mb-4 block">📖</span>
        <p class="text-neutral font-medium text-lg">Guías en preparación</p>
      </div>
    )}
  </section>
</BaseLayout>
