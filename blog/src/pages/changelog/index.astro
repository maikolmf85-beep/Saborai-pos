---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('changelog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const typeColors: Record<string, string> = {
  major: 'bg-emerald-600',
  minor: 'bg-blue-600',
  patch: 'bg-stone-500',
};

const typeLabels: Record<string, string> = {
  major: '🚀 Mayor',
  minor: '✨ Menor',
  patch: '🐛 Parche',
};
---

<BaseLayout
  title="Novedades y Actualizaciones — SaborAI POS"
  description="Historial completo de actualizaciones, nuevas funciones y mejoras de SaborAI POS. Mantente al día con las últimas novedades."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary via-stone-800 to-primary py-14 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-accent/20 text-accent rounded-full text-sm font-bold mb-5 border border-accent/30">
        🚀 Historial de Versiones
      </span>
      <h1 class="text-4xl md:text-5xl font-black font-heading text-white mb-4">
        Novedades de <span class="text-accent">SaborAI POS</span>
      </h1>
      <p class="text-white/70 text-lg max-w-xl mx-auto">
        Cada versión trae nuevas funciones, mejoras de rendimiento y correcciones para tu restaurante.
      </p>
    </div>
  </section>

  <!-- Legend -->
  <section class="border-b border-stone-200 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center gap-4">
      <span class="text-xs text-neutral font-medium">Tipos:</span>
      {Object.entries(typeLabels).map(([key, label]) => (
        <div class="flex items-center gap-1.5">
          <span class={`inline-flex w-5 h-5 rounded items-center justify-center text-white text-[9px] font-black ${typeColors[key]}`}>v</span>
          <span class="text-xs text-neutral">{label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Changelog Timeline -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    {entries.length > 0 ? (
      <div class="space-y-6">
        {entries.map((entry, i) => (
          <a
            href={`/changelog/${entry.slug}`}
            class="block group"
          >
            <div class="flex gap-5">
              <!-- Version Badge -->
              <div class="shrink-0 flex flex-col items-center">
                <span class={`inline-flex items-center justify-center w-12 h-12 rounded-2xl text-white font-black text-xs ${typeColors[entry.data.type]} shadow-md`}>
                  {entry.data.version}
                </span>
                {i < entries.length - 1 && (
                  <div class="w-px flex-1 bg-stone-200 mt-2 min-h-8"></div>
                )}
              </div>

              <!-- Content Card -->
              <div class="flex-1 pb-2">
                <div class="bg-white rounded-2xl border border-stone-200 p-6 card-hover shadow-sm group-hover:border-sage-300 transition-all">
                  <div class="flex items-start justify-between gap-4 mb-3">
                    <div>
                      <div class="flex items-center gap-2 mb-1">
                        <span class="text-xs font-bold text-neutral">{typeLabels[entry.data.type]}</span>
                        <span class="text-xs text-neutral">·</span>
                        <span class="text-xs text-neutral">
                          {entry.data.pubDate.toLocaleDateString('es-CR', { day: 'numeric', month: 'long', year: 'numeric' })}
                        </span>
                      </div>
                      <h2 class="text-lg font-black font-heading text-primary group-hover:text-sage-700 transition-colors">
                        {entry.data.title}
                      </h2>
                    </div>
                    <span class="text-sage-400 group-hover:text-sage-600 transition-colors shrink-0 mt-1">→</span>
                  </div>
                  <p class="text-sm text-neutral mb-4">{entry.data.description}</p>
                  {entry.data.highlights.length > 0 && (
                    <ul class="flex flex-wrap gap-2">
                      {entry.data.highlights.map((h) => (
                        <li class="badge-sage text-[10px]">✨ {h}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-stone-50 rounded-2xl border border-stone-200">
        <span class="text-5xl mb-4 block">🚀</span>
        <p class="text-neutral font-medium text-lg">Novedades próximamente</p>
      </div>
    )}
  </section>
</BaseLayout>
